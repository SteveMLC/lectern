# Copy to .dev.vars for local development. Never commit .dev.vars.
# Production values are set with `wrangler secret put <NAME>`.

# Passcode for the organizer console (required).
ORGANIZER_PASSCODE=speakerops-dev

# Optional — Airtable mirror. The token needs schema.bases:read,
# schema.bases:write, and data.records:write; the mirror creates its own
# tables, so you do not need to build the base by hand. See the README.
# AIRTABLE_TOKEN=
# AIRTABLE_BASE_ID=

# Optional — real email sending (Lane C wires this; simulated outbox without it).
# RESEND_API_KEY=

# Optional — AI-assisted drafting. Both the key and explicit mode are required;
# leaving mode disabled guarantees deterministic, zero-API-cost templates.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5
# AI_RUNTIME_MODE=disabled
