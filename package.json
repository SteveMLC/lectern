{
  "name": "lectern",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Open-source program operations: CFP forms, review, agenda, speaker ops, embeds. The program side of Sessionboard without the enterprise tax.",
  "license": "MIT",
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "dev": "vite build && wrangler dev",
    "dev:web": "vite",
    "build": "vite build",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "test": "vitest run",
    "verify": "pnpm usage:check && pnpm eval:requirements && pnpm check && pnpm test && pnpm build && wrangler deploy --dry-run",
    "eval:requirements": "node scripts/verify-eval-ledger.mjs",
    "eval:paid": "node scripts/run-paid-eval.mjs",
    "usage:check": "node scripts/usage-ledger.mjs check",
    "usage:summary": "node scripts/usage-ledger.mjs summary",
    "usage:report": "node scripts/usage-ledger.mjs report",
    "usage:receipt": "node scripts/usage-ledger.mjs receipt",
    "usage:runtime": "node scripts/usage-ledger.mjs runtime",
    "usage:snapshot": "node scripts/usage-ledger.mjs snapshot",
    "usage:sync": "node scripts/usage-ledger.mjs sync",
    "usage:install-hooks": "node scripts/install-usage-hooks.mjs",
    "release:preflight": "pnpm verify && node scripts/release-preflight.mjs",
    "submission:preflight": "node scripts/submission-preflight.mjs",
    "walkthrough:narrate": "node scripts/render-walkthrough-narration.mjs",
    "walkthrough:publish": "wrangler r2 object put lectern-assets/submission/lectern-walkthrough-final.mp4 --remote --file output/playwright/lectern-walkthrough-final.mp4 --content-type video/mp4 --content-disposition inline --cache-control \"public, max-age=3600\" --force",
    "smoke:production": "node scripts/smoke-production.mjs",
    "demo:reset:remote": "node scripts/reset-production-demo.mjs",
    "demo:check": "vitest run src/shared/domain/demoData.check.test.ts --reporter=verbose",
    "db:migrate:local": "wrangler d1 migrations apply lectern-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply lectern-db --remote",
    "db:seed:local": "wrangler d1 execute lectern-db --local --file seed/seed.sql && node scripts/seed-headshots.mjs --local",
    "db:seed:remote": "wrangler d1 execute lectern-db --remote --file seed/seed.sql && node scripts/seed-headshots.mjs --remote",
    "db:reset:local": "pnpm db:seed:local",
    "db:reset:remote": "pnpm demo:reset:remote",
    "cf:provision": "wrangler d1 create lectern-db && wrangler r2 bucket create lectern-assets",
    "deploy": "vite build && wrangler deploy",
    "headshots:seed:local": "node scripts/seed-headshots.mjs --local",
    "headshots:seed:remote": "node scripts/seed-headshots.mjs --remote"
  },
  "dependencies": {
    "clsx": "^2.1.0",
    "hono": "^4.6.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^7.5.0",
    "tailwind-merge": "^3.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241230.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "happy-dom": "^20.11.2",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.0",
    "vite": "^6.3.0",
    "vitest": "^3.1.0",
    "wrangler": "^4.74.0"
  }
}
