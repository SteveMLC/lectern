{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lectern",
  "main": "src/worker/index.ts",
  "compatibility_date": "2025-12-01",
  "workers_dev": true,
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Assets are served BEFORE the Worker by default, and SPA mode answers any
    // browser navigation with index.html. Worker-rendered pages must be listed
    // here or the SPA shell silently wins for real browsers (curl still sees
    // the Worker, which makes this a nasty one to catch).
    "run_worker_first": ["/demo", "/llms.txt", "/api/*"]
  },
  // D1/R2 resource names predate the Lectern rename (the product began as
  // "SpeakerOps"). Cloudflare cannot rename provisioned resources, and the
  // binding names the code sees (DB, BUCKET) are unaffected.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "speakerops-db",
      // Placeholder id works for --local dev. Replace with the real id printed by
      // `wrangler d1 create speakerops-db` before any --remote command or deploy.
      "database_id": "e18be5f8-4aca-49cb-b66e-6a9adf438a17",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "speakerops-assets"
    }
  ],
  "vars": {
    // Non-secret configuration only. Secrets (ORGANIZER_PASSCODE, AIRTABLE_TOKEN,
    // RESEND_API_KEY) go in .dev.vars locally and `wrangler secret put` in prod.
    "DATA_BACKEND": "d1",
    // Cost safety: an API key alone can never enable paid model calls.
    "AI_RUNTIME_MODE": "disabled",
    // Narrow exception: one cheap Haiku score draft per assignment per 15
    // minutes, only after an explicit reviewer click. Every call is logged.
    "AI_REVIEW_SCORING_MODE": "enabled",
    // Delivery safety: a key alone cannot send mail. Production is enabled,
    // while EMAIL_DELIVERY_ALLOWLIST (a Worker secret) limits real recipients.
    "EMAIL_DELIVERY_MODE": "resend"
  },
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["0 */6 * * *"]
  }
}
